# Leave DATA_MODE=mock to run the UI standalone with the built-in simulator.
# Set DATA_MODE=live and point the URLs at the real backend to switch over.
VITE_DATA_MODE=mock

# REST base for the ANPR platform API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket endpoint that streams live ANPR detection + alert events
VITE_REALTIME_URL=ws://localhost:8000/ws/events

# Optional: raster basemap tile template. Defaults to a keyless dark OSM/Carto style.
# VITE_BASEMAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
